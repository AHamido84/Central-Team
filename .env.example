# ---------------------------------------------------------------------------
# Central Team Platform — environment variables. Copy to .env.local.
# Local values come from `supabase status -o env`.
# ---------------------------------------------------------------------------

# Public app URL (used in email links and redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Direct Postgres connection used by Drizzle (withRls switches to role `authenticated`).
# Production: use the Supabase transaction pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Email: smtp | resend | console
EMAIL_PROVIDER=smtp
EMAIL_FROM="Central <no-reply@central.demo.local>"
SMTP_HOST=127.0.0.1
SMTP_PORT=54325
RESEND_API_KEY=

# Event dispatcher safety net: GET /api/cron/dispatch-events with "Authorization: Bearer $CRON_SECRET".
# Optional locally (events are dispatched right after each action); required in production (Vercel Cron).
CRON_SECRET=

# Signs the public lead form's load-time ticket (spam protection). Falls back to SUPABASE_SECRET_KEY when unset.
FORM_SIGNING_SECRET=

# --- Phase 7: integrations (ADR-067/068) -------------------------------------------------------------------------
# Leave a platform's variables commented out until you have its developer app: it then shows as "not configured"
# (the sandbox still works). OAuth redirect URI to register on each platform: <APP_URL>/api/integrations/callback/<provider>
# Webhook URL to register: <APP_URL>/api/hooks/<provider>  (meta | whatsapp | tiktok | snapchat | google)
# INTEGRATIONS_SANDBOX=1                      # sandbox providers in production (always on locally)
# INTEGRATIONS_SIGNING_SECRET=                # ≥16 chars; OAuth state + sandbox webhook HMAC (defaults to SUPABASE_SECRET_KEY)
# META_APP_ID=
# META_APP_SECRET=                            # also verifies Meta + WhatsApp webhook signatures
# META_WEBHOOK_VERIFY_TOKEN=                  # ≥8 chars, typed into the Meta app's webhook settings
# META_GRAPH_VERSION=v23.0
# TIKTOK_APP_ID=
# TIKTOK_APP_SECRET=
# SNAPCHAT_CLIENT_ID=
# SNAPCHAT_CLIENT_SECRET=
# SNAPCHAT_WEBHOOK_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=               # 10 digits, only when accounts are reached through a manager (MCC) account
# GOOGLE_ADS_API_VERSION=v21
# GOOGLE_LEAD_WEBHOOK_KEY=                    # the key typed into the Google Ads lead form webhook

# --- Phase 8: AI (ADR-073) -----------------------------------------------------------------------------------------
# Without keys, AI uses the built-in mock provider outside production and shows "not configured" in production.
# Live AI needs both keys (text by Anthropic Claude, embeddings by Voyage AI). Outbound hosts: api.anthropic.com,
# api.voyageai.com. AI also has an organization switch in /admin/ai (off by default for new organizations).
# AI_PROVIDER=mock                            # force the mock (allowed in production, e.g. for the demo)
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# VOYAGE_API_KEY=
# AI_EMBEDDING_MODEL=voyage-3.5               # must return 1024 dimensions (ai_chunks.embedding)
